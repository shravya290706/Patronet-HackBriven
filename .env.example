# ==============================================================================
# PATRONET Monorepo Environment Configuration Template
# ==============================================================================
# PATRONET consists of two primary services:
# 1. patronet-backend  (FastAPI + PostgreSQL + OpenSearch + Kafka)
# 2. patronet-frontend (React + TypeScript + Vite)
#
# See the respective subdirectories for service-specific .env templates:
# - patronet-backend/.env.example
# - patronet-frontend/.env.example
# ==============================================================================

# Common Dev Configuration
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Live Demo Deployments (Reference)
# Frontend: https://zealhackbriven.vercel.app
# Backend:  https://patronet-backend.onrender.com
