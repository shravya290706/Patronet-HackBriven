# ==============================================================================
# PATRONET Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values according to your environment.
# DO NOT include private tokens or backend secrets here (VITE_* is bundled client-side).
# ==============================================================================

# Centralized Backend API Base URL
# For local development with FastAPI running on port 8000:
VITE_API_BASE_URL=http://localhost:8000/api/v1

# For connecting to deployed backend in production, set to:
# VITE_API_BASE_URL=https://patronet-backend.onrender.com

# Alternate naming supported by client (for compatibility):
# VITE_API_URL=http://localhost:8000/api/v1

# Adapter mode:
# Set to 'false' (default) to communicate with real backend APIs.
# Set to 'true' only if running offline purely against local mock storage.
VITE_USE_MOCK_API=false
