# PATRONET Backend Environment Configuration

PROJECT_NAME="PATRONET API"
PROJECT_DESCRIPTION="E-commerce platform backend API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG="true"

# Server
HOST="0.0.0.0"
PORT=8000

# API Prefixes
API_PREFIX="/api"
API_V1_PREFIX="/v1"

# CORS (comma-separated list of origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
CORS_ALLOW_CREDENTIALS="true"

# Database (PostgreSQL - Future Phase)
DATABASE_URL="postgresql://patronet:patronet@localhost:5432/patronet_db"

# Event Streaming (Kafka - Future Phase)
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"

# Search Engine (OpenSearch - Future Phase)
OPENSEARCH_URL="http://localhost:9200"
