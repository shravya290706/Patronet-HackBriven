# ==============================================================================
# PATRONET Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values according to your environment.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# --- Application Metadata ---
PROJECT_NAME="PATRONET API"
PROJECT_DESCRIPTION="E-commerce platform backend API for modern retail operations"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG="true"

# --- Server Bind Configuration ---
HOST="0.0.0.0"
PORT=8000

# --- API Routing Prefixes ---
API_PREFIX="/api"
API_V1_PREFIX="/v1"

# --- Cross-Origin Resource Sharing (CORS) ---
# Comma-separated list of allowed origins.
# Include local development servers and your deployed frontend origin.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://zealhackbriven.vercel.app"
CORS_ALLOW_CREDENTIALS="true"

# --- Authentication & JWT Security ---
# Secret key used for signing JWT access tokens (use a strong random string in production)
JWT_SECRET_KEY="your-jwt-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database Configuration (Aiven PostgreSQL) ---
# Format: postgresql+psycopg://username:password@host:port/dbname?sslmode=require
DATABASE_URL="postgresql+psycopg://avnadmin:your-db-password@pg-patronet.aivencloud.com:25060/defaultdb?sslmode=require"

# --- OpenSearch Cluster Configuration (Aiven OpenSearch) ---
OPENSEARCH_URL="https://opensearch-patronet.aivencloud.com:25062"
OPENSEARCH_HOST="opensearch-patronet.aivencloud.com"
OPENSEARCH_PORT=25062
OPENSEARCH_USERNAME="avnadmin"
OPENSEARCH_PASSWORD="your-opensearch-password"
OPENSEARCH_USE_SSL="true"
OPENSEARCH_INDEX_NAME="patronet_products"

# --- Apache Kafka Event Streaming (Aiven Kafka) ---
KAFKA_BOOTSTRAP_SERVERS="kafka-patronet.aivencloud.com:25064"
KAFKA_SECURITY_PROTOCOL="SASL_SSL"
KAFKA_SASL_MECHANISM="PLAIN"
KAFKA_USERNAME="avnadmin"
KAFKA_PASSWORD="your-kafka-password"
KAFKA_ORDER_EVENTS_TOPIC="patronet.order.events"

# --- Google Gemini AI API Configuration ---
# Official google-genai SDK configuration for PATRONET USPs (Comparor, Negotiator, Shopping Buddy)
# If empty or not set, the platform operates seamlessly using its deterministic business logic engines.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
